# Cloud.ru Foundation Models
CLOUDRU_API_KEY=
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1

# Models (overridable, defaults сохранены в llm/cloudru.py)
MODEL_PARSE_BRIEF=deepseek-ai/DeepSeek-V4-Pro
MODEL_MESSAGE_GEN=zai-org/GLM-5.1
MODEL_PERSONA_EVAL=zai-org/GLM-5.1
MODEL_VISION=moonshotai/Kimi-K2.6

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated TG user IDs (admin is the first one)
WHITELIST_USER_IDS=

# Redis
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
TRACES_DIR=/data/traces

# Artifact TTL janitor (cleans /data/{heroes,renders,zips} of files older than TTL).
# Tracker is mtime-based; /data/traces is NOT touched.
ARTIFACT_TTL_HOURS=24
ARTIFACT_SWEEP_INTERVAL_S=3600
