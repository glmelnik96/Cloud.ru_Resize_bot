# Cloud.ru Foundation Models
CLOUDRU_API_KEY=
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1

# Models (overridable, defaults сохранены в llm/cloudru.py)
MODEL_PARSE_BRIEF=deepseek-ai/DeepSeek-V4-Pro
MODEL_MESSAGE_GEN=zai-org/GLM-5.1
MODEL_PERSONA_EVAL=zai-org/GLM-5.1
MODEL_VISION=moonshotai/Kimi-K2.6

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated TG user IDs (admin is the first one)
WHITELIST_USER_IDS=

# Redis
REDIS_URL=redis://redis:6379/0

# Figma
FIGMA_FILE_KEY=
FIGMA_MCP_URL=https://api.figma.com/mcp
FIGMA_API_TOKEN=

# Phygital (vendored client config — populated в M3)
PHYGITAL_BASE_URL=https://app-server-azure.phygital.plus

# Object storage (Cloud.ru S3-compatible) — для hosting Phygital images Figma createImageAsync
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-central-1

# Logging
LOG_LEVEL=INFO
TRACES_DIR=/data/traces

# Playwright
PLAYWRIGHT_USER_DATA=/data/user_data
