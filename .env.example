# Cloud.ru Foundation Models
CLOUDRU_API_KEY=
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1

# Models (overridable, defaults сохранены в llm/cloudru.py)
MODEL_PARSE_BRIEF=deepseek-ai/DeepSeek-V4-Pro
MODEL_MESSAGE_GEN=zai-org/GLM-5.1
MODEL_PERSONA_EVAL=zai-org/GLM-5.1
MODEL_VISION=moonshotai/Kimi-K2.6

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated TG user IDs (admin is the first one)
WHITELIST_USER_IDS=

# Redis
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
TRACES_DIR=/data/traces

# Artifact TTL janitor (cleans /data/{heroes,renders,zips} of files older than TTL).
# Tracker is mtime-based; /data/traces is NOT touched.
ARTIFACT_TTL_HOURS=24
ARTIFACT_SWEEP_INTERVAL_S=3600

# M3.4: Bot-to-bot hero image generation via @Cloud_Phygital_bot.
# When USE_PHYGITAL_RENDER=true, the graph delegates hero generation to that
# bot over Telegram Bot API 10.0 bot-to-bot messaging instead of asking the
# user to upload manually. Both bots must have Bot-to-Bot Communication Mode
# enabled in BotFather, and the other side must have our bot in its
# B2B_BOT_WHITELIST. On error/timeout, the bot falls back to the manual HITL
# upload prompt.
USE_PHYGITAL_RENDER=false
PHYGITAL_BOT_USERNAME=Cloud_Phygital_bot
PHYGITAL_REQUEST_TIMEOUT_S=1200

# Speculative hero prefetch: start style->prompt->b2b render in the background
# while the user is still reading the text-approve prompt. PREFETCH_DELAY_S is
# the hedge window before any cost is incurred (instant regenerate within it
# cancels the bet for free). Only active when USE_PHYGITAL_RENDER=true.
PREFETCH_HERO=true
PREFETCH_DELAY_S=10
