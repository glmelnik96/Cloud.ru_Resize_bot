# App3 / creatives — web sub-app env (App1-style key names).
# Copy to .env on the VM; never commit real secrets.

# --- gateway sub-app contract ---
PORT=8013
DB_URL=sqlite+aiosqlite:///./data/app3.db
RESULTS_DIR=./data/results

# --- scratch dirs (graph render outputs) ---
HEROES_DIR=./data/heroes
RENDERS_DIR=./data/renders
ZIPS_DIR=./data/zips
TMP_ROOT=./data/tmp

# --- queue limits ---
MAX_CONCURRENCY=5
MAX_PER_USER_INFLIGHT=2
USER_QUEUE_LIMIT=5

# --- HITL / retention ---
IMAGE_TIMEOUT_SEC=86400
RETENTION_TTL_SEC=86400

# --- langgraph checkpointer: SQLite (durable HITL park/resume; no Redis) ---
CHECKPOINT_DB=./data/app3_checkpoints.db

# --- hero generation: delegated to App1 (platform decision 2026-06-21) ---
# none = manual upload only (default until App1's /internal/hero is live)
# app1 = POST prompt to App1's loopback endpoint
HERO_GEN_BACKEND=none
APP1_HERO_URL=http://127.0.0.1:8011/internal/hero

# --- unified usage stats push (platform decision 2026-07-22) ---
# Each completed op (done/failed/cancelled) is POSTed to the gateway ingest so
# /admin folds every sub-app into one picture. Metric only — no images/prompt.
# Leave url or token empty to disable the push (local/dev); the local
# usage_events row is still written and stays the source of truth.
USAGE_INGEST_URL=https://cloudrudesign.ru/internal/usage
USAGE_INGEST_TOKEN=
# Technical/smoke accounts excluded from usage entirely (local + push).
USAGE_EXCLUDED_EMAILS=e2e-smoke@cloud.ru

# --- Cloud.ru FM (LLM) ---
CLOUDRU_API_KEY=
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1

LOG_LEVEL=INFO
